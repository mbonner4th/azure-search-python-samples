# ---------------------------------------------------------------------------
# Pulse RAG eval harness — environment template.
# Copy to .env and fill in. All scripts under eval/ load this via python-dotenv.
# ---------------------------------------------------------------------------

# Foundry project endpoint (same one your pulse-rag app uses).
PROJECT_ENDPOINT=https://YOUR-FOUNDRY-PROJECT.cognitiveservices.azure.com/api/projects/YOUR-PROJECT

# Resource ID of the underlying Foundry (AIServices) account. Needed to
# deploy the judge model via the management plane. Format:
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<acct>
FOUNDRY_ACCOUNT_RESOURCE_ID=

# Model deployment used as the *judge* by the LLM-based evaluators. Created
# by scripts/deploy_judge_model.py. Recommended: gpt-5-mini, fall back to
# gpt-4.1-mini if quota / regional availability blocks gpt-5-mini.
AZURE_AI_JUDGE_MODEL_DEPLOYMENT_NAME=eval-judge-gpt5mini

# Model deployment the eval *agent* itself runs on (the brain that decides
# whether to call the search_devices tool). Reuse your existing chat model.
EVAL_AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Name/version of the Foundry agent created by agent/create_agent.py. The
# eval runner targets this agent so tool calls are evaluable end-to-end.
EVAL_AGENT_NAME=pulse-device-agent
EVAL_AGENT_VERSION=1

# AI Search target — must point at the SAME index the production pulse-rag
# app uses so the eval reflects production retrieval behavior.
SearchServiceEndpoint=https://YOUR-SEARCH-SERVICE.search.windows.net
SearchIndexName=pulse-device-chunks

# Optional: enable hybrid + semantic ranking in the function tool (matches
# what app/retrieval.py does when EnableSemanticRanking=true).
EnableSemanticRanking=false

# Dataset config — change these only if you fork the golden dataset.
EVAL_DATASET_NAME=pulse-rag-golden
EVAL_DATASET_VERSION=1
